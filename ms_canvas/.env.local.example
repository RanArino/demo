# ms_canvas environment example

# gRPC server
GRPC_PORT=50054

# Authentication
CLERK_SECRET_KEY=<clerk_secret_key>

# Neo4j Aura / Neo4j
NEO4J_URI=neo4j+s://<your-aura-endpoint>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j_password>
NEO4J_DATABASE=neo4j

# Confluent Kafka
KAFKA_BROKERS=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_USERNAME=<confluent_api_key>
KAFKA_SASL_PASSWORD=<confluent_api_secret>
KAFKA_GROUP_ID=ms_canvas-consumer-group
TOPIC_DOCUMENT_PROCESSED=document.processed

# Local development (uncomment to use a local broker)
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_BROKERS=localhost:9092
