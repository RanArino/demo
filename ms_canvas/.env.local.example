# ==============================================================================
# ms_canvas Configuration (Go App)
# ==============================================================================

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_GROUP_ID=ms_canvas-consumer-group

# gRPC Configuration
GRPC_PORT=50054

# Authentication (shared with ms_user)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Kafka Topics
TOPIC_DOCUMENT_PROCESSED=document.processed

# Python Service Configuration
CANVAS_PY_HOST=localhost
CANVAS_PY_PORT=50054
CANVAS_MAX_GRPC_MSG_BYTES=67108864

# ==============================================================================
# ms_canvas Python App Configuration
# ==============================================================================

# Server Configuration
CANVAS_PY_HOST=0.0.0.0
CANVAS_PY_PORT=50054
CANVAS_MAX_GRPC_MSG_BYTES=67108864

# Chunking and Embedding Configuration
CANVAS_CHUNK_TARGET_TOKENS=300
CANVAS_CHUNK_OVERLAP_PERCENT=10
CANVAS_TOKENIZER=tiktoken:cl100k_base
CANVAS_BATCH_SIZE=50

# Embeddings / LLM Configuration
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Tests Configuration
INTEGRATION_TESTS=0
RUN_BENCHMARKS=0

# ==============================================================================
# ms_user Configuration (for reference/shared secrets)
# ==============================================================================

# Database Configuration (ms_user)
DATABASE_URL=

# Server Ports (ms_user)
# GRPC_PORT=50051  # ms_user uses 50051, ms_canvas uses 50054
# WEBHOOK_PORT=8081

# Webhook Configuration (ms_user)
WEBHOOK_MAX_BODY_SIZE_MB=1
DEFAULT_STORAGE_QUOTA_GB=5

# Environment
ENVIRONMENT=development
