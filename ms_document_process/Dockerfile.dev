FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install Poetry and watchdog's CLI (watchmedo)
# System build tools for packages with native extensions (e.g., watchdog on Py3.13)
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir poetry watchdog[watchmedo]

# Install only dependency metadata first for better caching
COPY pyproject.toml poetry.lock ./

# Force Poetry to install into the global environment, not a venv
ENV POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VIRTUALENVS_IN_PROJECT=false

RUN poetry install --no-root --no-interaction --no-ansi

# Copy source code (will be mounted as volume)
COPY . .

EXPOSE 50053

ENV PYTHONPATH=/app

# Use watchmedo for hot reloading
CMD ["watchmedo", "auto-restart", "--directory=.", "--pattern=*.py", "--recursive", "--", "python", "-m", "app.main"]