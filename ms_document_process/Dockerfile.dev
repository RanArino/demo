FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install Poetry and watchdog's CLI (watchmedo)
RUN pip install --no-cache-dir poetry watchdog[watchmedo]

# Copy and install the shared pkg as a dependency
COPY pkg /tmp/pkg
RUN pip install --no-cache-dir /tmp/pkg

# Install only dependency metadata first for better caching
COPY ms_document_process/pyproject.toml ms_document_process/poetry.lock ./

# Force Poetry to install into the global environment, not a venv
ENV POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VIRTUALENVS_IN_PROJECT=false

RUN poetry install --no-root --no-interaction --no-ansi

# Copy source code (will be mounted as volume)
COPY ms_document_process/ .

EXPOSE 50053

ENV PYTHONPATH=/app

# Use watchmedo for hot reloading
CMD ["watchmedo", "auto-restart", "--directory=.", "--pattern=*.py", "--recursive", "--", "python", "-m", "app.main"]