# Document Process Service env example
# Copy to .env.local and fill values

# gRPC
GRPC_PORT=50053

# Kafka via AWS MSK Serverless
# Example TLS bootstrap servers: boot-abc123.serverless.kafka.us-east-1.amazonaws.com:9098
KAFKA_BROKERS=
AWS_REGION=
# # Local development only (leave empty in cloud runtimes using IAM roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Internal service URLs
MS_KNOWLEDGE_GRPC_URL=ms_knowledge:50052
