# Document Process Service env example
# Copy to .env.local and fill values

# gRPC
GRPC_PORT=50053

# Confluent Cloud Kafka Configuration
KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=your_api_key_here
KAFKA_SASL_PASSWORD=your_api_secret_here
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_SOURCE_NAME=
R2_BUCKET_PROCESSED_NAME=

# LLM Provider Configuration
# Choose provider: openai (default) | vertex | gemini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_SUMMARY_TOKENS=512
LLM_KEYWORD_COUNT=10

# OpenAI Configuration (default provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini-2025-08-07

# Vertex AI Configuration (optional, for LLM_PROVIDER=vertex)
VERTEX_PROJECT_ID=your_gcp_project_id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash

# Gemini Configuration (optional, for LLM_PROVIDER=gemini or backward compatibility)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-1.5-flash

# Internal service URLs
MS_KNOWLEDGE_GRPC_URL=ms_knowledge:50052
