# Knowledge Service env example
# Copy to .env.local and fill values

# gRPC
GRPC_PORT=50052
UserGRPCAddr="localhost:50051"

# Clerk
CLERK_SECRET_KEY=

# Postgres (Knowledge Service DB)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable


# Confluent Cloud Kafka Configuration
KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=your_api_key_here
KAFKA_SASL_PASSWORD=your_api_secret_here
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# Cloudflare R2
R2_ENDPOINT=
R2_REGION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_SOURCE_NAME=
R2_BUCKET_PROCESSED_NAME=
