# Knowledge Service env example
# Copy to .env.local and fill values

# gRPC
GRPC_PORT=50052

# Postgres (Knowledge Service DB)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Kafka via AWS MSK Serverless
# Example TLS bootstrap servers: boot-abc123.serverless.kafka.us-east-1.amazonaws.com:9098
KAFKA_BROKERS=
AWS_REGION=
# Local development only (leave empty in cloud runtimes using IAM roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
